# Model access is needed only for discovery. Never commit real keys.
SWIVEL_LLM_PROVIDER=openai
OPENAI_API_KEY=
SWIVEL_LLM_MODEL=gpt-5.1

# Optional alternative provider.
# SWIVEL_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Simulator credentials contain no real accounts or financial data.
SWIVEL_CRED_MERIDIAN_OPERATOR_ID=msr01
SWIVEL_CRED_MERIDIAN_PASSWORD=meridian
SWIVEL_CONSOLE_PORT=4700
SWIVEL_DATA_DIR=.swivel
SWIVEL_HEADLESS=true
# Set this to an installed Chromium/Chrome binary, or install Playwright Chromium.
# SWIVEL_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Set a strong stable value for a persistent console deployment.
# SWIVEL_SESSION_SECRET=
