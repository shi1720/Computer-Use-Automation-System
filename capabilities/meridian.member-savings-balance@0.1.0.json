{
  "apiVersion": "swivel.dev/cap-1",
  "kind": "Capability",
  "metadata": {
    "id": "meridian.member-savings-balance",
    "version": "0.1.0",
    "title": "Read a member's savings balance",
    "summary": "Looked up the specified member by member number, located the {{input.shareType}} share in the Share Accounts section, and recorded its current and available balances.",
    "createdAt": "2026-09-22T03:05:15.794Z",
    "labels": {},
    "owner": "shivam"
  },
  "target": {
    "surface": "web",
    "vendor": "Meridian Financial Systems",
    "product": "MERIDIAN Core Banking",
    "productVersions": "~9.2.14",
    "entry": {
      "urlTemplate": "{{tenant.baseUrl}}/main",
      "expectedFrames": [
        "navFrame",
        "contentFrame"
      ]
    },
    "vocabulary": {
      "member": "Member",
      "memberNumber": "Member #",
      "share": "Share",
      "shareList": "Share Accounts"
    }
  },
  "contract": {
    "inputs": [
      {
        "name": "memberNumber",
        "type": "string",
        "description": "The credit union member number, 7 digits",
        "required": true,
        "example": "0100482",
        "sensitivity": "pii",
        "pattern": "^[0-9]{7}$"
      },
      {
        "name": "shareType",
        "type": "string",
        "description": "The share product to read, exactly as the core displays it",
        "required": true,
        "example": "SPECIAL SAVINGS",
        "sensitivity": "internal"
      }
    ],
    "outputs": [
      {
        "name": "currentBalance",
        "type": "money",
        "description": "Current balance of the SPECIAL SAVINGS share for member 0100482",
        "sensitivity": "sensitive",
        "required": false
      },
      {
        "name": "availableBalance",
        "type": "money",
        "description": "Available balance of the SPECIAL SAVINGS share for member 0100482",
        "sensitivity": "sensitive",
        "required": false
      }
    ],
    "outcomes": [
      {
        "code": "RECORD_NOT_FOUND",
        "kind": "business",
        "description": "No record matched the search criteria supplied by the caller.",
        "retryable": false
      },
      {
        "code": "NOT_AUTHORIZED",
        "kind": "business",
        "description": "The signed-in operator lacks authority for this transaction. A supervisor override is required.",
        "retryable": false
      },
      {
        "code": "VALIDATION_FAILED",
        "kind": "business",
        "description": "The application rejected the supplied values. The message field carries the core's own wording.",
        "retryable": false
      },
      {
        "code": "SYSTEM_UNAVAILABLE_EOD",
        "kind": "business",
        "description": "The core is in end-of-day processing. Maintenance functions are unavailable until it completes.",
        "retryable": true
      },
      {
        "code": "RECORD_LOCKED",
        "kind": "business",
        "description": "The record is held by another operator and was still held after retrying.",
        "retryable": true
      }
    ],
    "effects": {
      "mutating": false,
      "reversible": true,
      "riskClass": "read_only",
      "dualControl": false,
      "financialImpact": false,
      "idempotent": true,
      "summary": "This capability only reads. It makes no change to any record."
    },
    "preconditions": []
  },
  "policy": {
    "allowedOrigins": [
      "http://127.0.0.1:4711"
    ],
    "allowedPathPatterns": [
      "^/($|(content|nav|main|signon|compliance-ack))"
    ],
    "allowedActions": [
      "navigate",
      "click",
      "fill",
      "select",
      "press",
      "wait_for",
      "extract",
      "assert",
      "dismiss_if_present"
    ],
    "requiresApproval": true,
    "requiresPerInvocationConfirmation": false,
    "maxDurationMs": 120000,
    "maxSteps": 60,
    "redactPatterns": []
  },
  "signals": [
    {
      "id": "session_expired",
      "title": "Operator session timed out",
      "kind": "recoverable",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*0900|SESSION HAS TIMED OUT|session has expired",
          "because": "the core drops you to a re-authentication screen inside the content frame"
        }
      ],
      "recovery": {
        "strategy": "reauthenticate",
        "maxAttempts": 2,
        "backoffMs": 500,
        "steps": []
      },
      "exceptStepIds": [],
      "capture": []
    },
    {
      "id": "transient_server_error",
      "title": "Application server returned 503",
      "kind": "recoverable",
      "detect": [
        {
          "kind": "text_present",
          "regex": "HTTP 503|Service Temporarily Unavailable|did not respond within the configured timeout"
        }
      ],
      "recovery": {
        "strategy": "wait_and_retry",
        "maxAttempts": 3,
        "backoffMs": 1500,
        "steps": []
      },
      "exceptStepIds": [],
      "capture": []
    },
    {
      "id": "compliance_interstitial",
      "title": "BSA/OFAC review notice",
      "kind": "recoverable",
      "detect": [
        {
          "kind": "text_present",
          "regex": "BSA/OFAC NOTICE|RESTRICTED RECORD|COMPLIANCE REVIEW",
          "because": "flagged members trigger an acknowledgement screen before the record opens"
        }
      ],
      "recovery": {
        "strategy": "run_steps",
        "maxAttempts": 1,
        "backoffMs": 0,
        "steps": [
          {
            "id": "ack_compliance_notice",
            "intent": "Acknowledge the BSA/OFAC review notice so the record opens",
            "kind": "click",
            "risk": "low",
            "target": {
              "id": "acknowledge_notice",
              "role": "button",
              "name": {
                "value": "Acknowledge and Continue",
                "match": "normalized"
              }
            },
            "authoredBy": "human"
          }
        ]
      },
      "exceptStepIds": [],
      "capture": []
    },
    {
      "id": "record_locked",
      "title": "Record in use by another operator",
      "kind": "recoverable",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*0310|IS IN USE BY OPERATOR|RECORD IN USE"
        }
      ],
      "recovery": {
        "strategy": "wait_and_retry",
        "maxAttempts": 3,
        "backoffMs": 2000,
        "steps": []
      },
      "exhaustedOutcomeCode": "RECORD_LOCKED",
      "exceptStepIds": [],
      "capture": [
        {
          "name": "lockedBy",
          "regex": "IN USE BY OPERATOR (\\w+)"
        }
      ]
    },
    {
      "id": "no_record_found",
      "title": "Search returned no records",
      "kind": "business",
      "outcomeCode": "RECORD_NOT_FOUND",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*0042|NO (?:MEMBER|CUSTOMER) RECORD FOUND"
        }
      ],
      "exceptStepIds": [],
      "capture": []
    },
    {
      "id": "permission_denied",
      "title": "Operator not authorised for this function",
      "kind": "business",
      "outcomeCode": "NOT_AUTHORIZED",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*0451|OPERATOR NOT AUTHORIZED|INSUFFICIENT AUTHORITY"
        }
      ],
      "exceptStepIds": [],
      "capture": [
        {
          "name": "authorizationDetail",
          "regex": "MSG\\s*0451[\\s\\S]{0,20}?([A-Z][\\s\\S]{0,160}?\\.)"
        }
      ]
    },
    {
      "id": "eod_lockout",
      "title": "Core is in end-of-day processing",
      "kind": "business",
      "outcomeCode": "SYSTEM_UNAVAILABLE_EOD",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*0600|END-OF-DAY PROCESSING"
        }
      ],
      "exceptStepIds": [],
      "capture": []
    },
    {
      "id": "validation_error",
      "title": "The core rejected the submitted values",
      "kind": "business",
      "outcomeCode": "VALIDATION_FAILED",
      "detect": [
        {
          "kind": "text_present",
          "regex": "MSG\\s*00(07|21|31|74)|MSG\\s*02(12|33|44)|MSG\\s*0455|DATA ERROR|REQUIRED FIELD IS MISSING|MINIMUM OPENING DEPOSIT"
        }
      ],
      "exceptStepIds": [],
      "capture": [
        {
          "name": "validationMessage",
          "regex": "(MSG\\s*\\d{4}[\\s\\S]{0,160}?\\.)"
        }
      ]
    }
  ],
  "flow": {
    "steps": [
      {
        "id": "click_member_search",
        "intent": "Open the {{vocab.member}} Search screen from the main menu to look up the {{vocab.member}} by {{vocab.member}} number.",
        "kind": "click",
        "target": {
          "id": "member_search",
          "role": "link",
          "frame": {
            "path": [
              "navFrame"
            ]
          },
          "name": {
            "value": "{{vocab.member}} Search",
            "match": "exact"
          },
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "tag": "a"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by name"
        },
        "risk": "read_only",
        "expect": {
          "id": "click_member_search_ok",
          "description": "Reached screen INQ-0410",
          "all": [
            {
              "kind": "text_present",
              "regex": "SCREEN\\s+INQ-0410",
              "because": "the core stamps a screen identifier on every page; it is stable across runs and carries no member data"
            }
          ],
          "timeoutMs": 15000,
          "stableForMs": 0
        },
        "authoredBy": "model"
      },
      {
        "id": "fill_member",
        "intent": "Enter the provided {{vocab.member}} number into the {{vocab.member}} # field for an exact {{vocab.member}} search.",
        "kind": "fill",
        "target": {
          "id": "member",
          "role": "textbox",
          "frame": {
            "path": [
              "contentFrame"
            ]
          },
          "anchors": [
            {
              "relation": "right-of",
              "text": {
                "value": "{{vocab.memberNumber}}",
                "match": "normalized"
              },
              "maxDistancePx": 320
            }
          ],
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "idPattern": "ctl\\d+_Main_txtMemberNo",
            "tag": "input",
            "inputType": "text"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by anchor + idPattern (control has no accessible name — the application never associated a label)"
        },
        "value": "{{input.memberNumber}}",
        "risk": "read_only",
        "authoredBy": "model"
      },
      {
        "id": "click_search",
        "intent": "Run the {{vocab.member}} search using the entered {{vocab.member}} number for an exact match.",
        "kind": "click",
        "target": {
          "id": "search",
          "role": "button",
          "frame": {
            "path": [
              "contentFrame"
            ]
          },
          "name": {
            "value": "Search",
            "match": "exact"
          },
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "idPattern": "ctl\\d+_Main_btnSearch",
            "tag": "input",
            "inputType": "submit"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by name + idPattern"
        },
        "risk": "read_only",
        "expect": {
          "id": "click_search_ok",
          "description": "Reached screen INQ-0411",
          "all": [
            {
              "kind": "text_present",
              "regex": "SCREEN\\s+INQ-0411",
              "because": "the core stamps a screen identifier on every page; it is stable across runs and carries no member data"
            }
          ],
          "timeoutMs": 15000,
          "stableForMs": 0
        },
        "authoredBy": "model"
      },
      {
        "id": "click_action_cell",
        "intent": "Activate the \"View\" link in the row where {{vocab.memberNumber}} is {{input.memberNumber}}.",
        "kind": "click",
        "target": {
          "id": "action_cell",
          "role": "link",
          "frame": {
            "path": [
              "contentFrame"
            ]
          },
          "name": {
            "value": "View",
            "match": "exact"
          },
          "cell": {
            "columnHeader": {
              "value": "Action",
              "match": "normalized"
            },
            "rowWhere": {
              "columnHeader": {
                "value": "{{vocab.memberNumber}}",
                "match": "normalized"
              },
              "equals": "{{input.memberNumber}}",
              "match": "normalized"
            }
          },
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "idPattern": "ctl\\d+_Main_grdResults_ctl\\d+_lnkView",
            "tag": "a"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by name + column + row + idPattern"
        },
        "risk": "read_only",
        "expect": {
          "id": "click_action_cell_ok",
          "description": "Reached screen INQ-0420",
          "all": [
            {
              "kind": "text_present",
              "regex": "SCREEN\\s+INQ-0420",
              "because": "the core stamps a screen identifier on every page; it is stable across runs and carries no member data"
            }
          ],
          "timeoutMs": 15000,
          "stableForMs": 0
        },
        "authoredBy": "model"
      },
      {
        "id": "extract_current_balance",
        "intent": "Capture the current balance of the {{input.shareType}} {{vocab.share}} account from the {{vocab.shareList}} grid.",
        "kind": "extract",
        "target": {
          "id": "balance_cell",
          "role": "cell",
          "frame": {
            "path": [
              "contentFrame"
            ]
          },
          "cell": {
            "columnHeader": {
              "value": "Balance",
              "match": "normalized"
            },
            "rowWhere": {
              "columnHeader": {
                "value": "Type",
                "match": "normalized"
              },
              "equals": "{{input.shareType}}",
              "match": "normalized"
            }
          },
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "tag": "td"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by column + row"
        },
        "risk": "read_only",
        "extract": {
          "into": "currentBalance",
          "source": "text",
          "transform": "money_to_number"
        },
        "authoredBy": "model"
      },
      {
        "id": "extract_available_balance",
        "intent": "Capture the available balance of the {{input.shareType}} {{vocab.share}} account from the {{vocab.shareList}} grid.",
        "kind": "extract",
        "target": {
          "id": "available_cell",
          "role": "cell",
          "frame": {
            "path": [
              "contentFrame"
            ]
          },
          "cell": {
            "columnHeader": {
              "value": "Available",
              "match": "normalized"
            },
            "rowWhere": {
              "columnHeader": {
                "value": "Type",
                "match": "normalized"
              },
              "equals": "{{input.shareType}}",
              "match": "normalized"
            }
          },
          "hints": {
            "css": [],
            "nearText": [],
            "attrs": {},
            "tag": "td"
          },
          "require": {
            "minScore": 60,
            "unique": true,
            "timeoutMs": 10000
          },
          "note": "identified by column + row"
        },
        "risk": "read_only",
        "extract": {
          "into": "availableBalance",
          "source": "text",
          "transform": "money_to_number"
        },
        "authoredBy": "model"
      }
    ],
    "successCheckpoint": {
      "id": "capability_complete",
      "description": "SCREEN INQ-0420",
      "all": [
        {
          "kind": "text_present",
          "regex": "SCREEN\\s+INQ-0420",
          "because": "the core stamps a screen identifier on every page; it is stable across runs and carries no member data"
        }
      ],
      "timeoutMs": 20000,
      "stableForMs": 0
    }
  },
