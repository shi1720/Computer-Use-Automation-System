# ── LLM provider ──────────────────────────────────────────────────────────────
# Swivel needs a model ONLY for discovery (and the optional bounded repair step).
# Replay never calls a model.
SWIVEL_LLM_PROVIDER=anthropic          # anthropic | claude-cli | mock
ANTHROPIC_API_KEY=sk-ant-...           # required when provider=anthropic
SWIVEL_LLM_MODEL=claude-sonnet-5       # discovery model

# ── Console ───────────────────────────────────────────────────────────────────
SWIVEL_CONSOLE_PORT=4700
SWIVEL_SESSION_SECRET=change-me-in-production

# ── Simulated target (Meridian) ───────────────────────────────────────────────
MERIDIAN_PINERIDGE_PORT=4711
MERIDIAN_HARBORPOINT_PORT=4712

# ── Runtime ───────────────────────────────────────────────────────────────────
SWIVEL_HEADLESS=true
SWIVEL_DATA_DIR=.swivel
